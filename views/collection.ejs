<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title><%= collectionName %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"  rel="stylesheet">
</head>
<body>
  <div class="container mt-4">
    <h1 class="mb-4"><%= collectionName %></h1>

    <!-- Кнопка добавления -->
    <a href="/collections/<%= collectionPath %>/add" class="btn btn-success mb-3">Добавить запись</a>

    <!-- Таблица записей -->
    <table class="table table-striped table-bordered">
      <thead class="table-dark">
        <tr>
          <% fields.forEach(function(field) { %>
            <th><%= field.label.charAt(0).toUpperCase() + field.label.slice(1) %></th>
          <% }) %>
          <th>Действия</th>
        </tr>
      </thead>
      <tbody>
  <% items.forEach(function(item) { %>
    <tr>
      <% fields.forEach(function(field) { %>
        <%
          const value = item[field.key];
          let displayValue = '-';

          if (value !== undefined && value !== null) {
            if (value instanceof Date) {
              displayValue = value.toLocaleString();
            } 
            else if (Array.isArray(value)) {
              displayValue = '<ul class="mb-0 ps-3">' + 
                value.map(v => `<li>${typeof v === 'object' && v !== null ? JSON.stringify(v) : v}</li>`).join('') + 
                '</ul>';
            }
            else if (typeof value === 'object') {
              displayValue = JSON.stringify(value);
            }
            else {
              displayValue = value;
            }
        %>
        <td><%- displayValue %></td>
      <% }) %>
      <td>
        <a href="/collections/<%= collectionPath %>/<%= item._id %>/edit" class="btn btn-primary btn-sm me-1">Изменить</a>
        <form action="/collections/<%= collectionPath %>/<%= item._id %>?_method=DELETE" method="POST" style="display:inline;">
          <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Вы уверены?')">Удалить</button>
        </form>
      </td>
    </tr>
  <% }) %>
</tbody>
    </table>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script> 
</body>
</html>