<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Главная</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"  rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="main-container flex-column d-flex align-items-center">
    <div class="container d-flex align-items-center">
        <h1>Управление базой данных торговой организации</h1>

        <div class="row row-cols-1 row-cols-md-3 g-4">
        <% collections.forEach(function(collection) { %>
            <div class="col collection-card">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                <h5 class="card-title"><%= collection.name %></h5>
                <p class="card-text text-muted">Количество документов: <%= collection.count %></p>
                <a href="/collections/<%= collection.path %>" class="btn btn-primary mt-auto">Перейти</a>
                </div>
            </div>
            </div>
        <% }) %>
        </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script> 
</body>
</html>